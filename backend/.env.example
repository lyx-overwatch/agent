# ── 必需 ──────────────────────────────────────────────
SECRET_KEY=<与 Java 端相同的 HMAC512 密钥>
ALGORITHM=HS512
LOGIN_USER_KEY=login_user_key

# ── 数据库 ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:qwer@localhost/agent

# ── Checkpointer 清理（仅 postgres checkpointer 生效）──────────
# keep_latest 语义：删除「ts 超过保留期」的中间快照，但每个 thread 永远保留
# 最新一条（含完整累积 state），续聊上下文不丢失；仅失去回退到很久之前某个
# 中间步骤的「时间旅行」能力。
CHECKPOINT_CLEANUP_ENABLED=true
CHECKPOINT_CLEANUP_TTL_DAYS=30
CHECKPOINT_CLEANUP_INTERVAL_SECONDS=3600

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── 会话创建限流（秒）─────────────────────────────────
# 同一用户创建会话的最小间隔。0/负数关闭限流。
CONVERSATION_CREATE_MIN_INTERVAL_SECONDS=3

# ── LLM ───────────────────────────────────────────────
VOLCENGINE_API_KEY=<腾讯 MAS API Key>

# ── CORS (本地开发) ───────────────────────────────────
# 本地前端 (Docker nginx on :80) 访问后端 :8001 是跨域
# 线上环境前端和 API 同源，无需设置 CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3030,http://localhost,http://127.0.0.1

# ── 其他 API Key ──────────────────────────────────────
JINA_API_KEY=
QCC_API_KEY=
# 通用 web_search 工具（豆包搜索，CUE 网关 https://cuecue.cn/llm-api）
WEB_SEARCH_API_KEY=

# ── 部署相关 ──────────────────────────────────────────
ENVIRONMENT=local
# SKILLHUB_CONFIG_PATH=/path/to/config.yaml

# ── 文件存储 ──────────────────────────────────────────
# local: 本地磁盘（默认，零配置开发环境）
# s3:    S3 兼容对象存储（华为云 OBS / MinIO / AWS S3）
STORAGE_BACKEND=local
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=skillhub-files
S3_REGION=
S3_ADDRESSING_STYLE=virtual  # virtual for OBS, path for MinIO
# 反向代理前缀：下载 URL 用它替换 OBS 直连地址（V2 签名，主机无关）。
# 例: https://agc-study.oa.cmbchina.biz/obs ；留空则用 OBS 直连预签名地址（开发/MinIO）
S3_PROXY_URL=
DOWNLOAD_URL_EXPIRES=3600

# ── Provisioner（仅 SkillHub 主后端需要）──────────────
# 本地开发留空（使用 LocalContainerBackend 直接管理 Docker 容器）
# CCE / K8s 部署时设置为: http://provisioner:8002
# PROVISIONER_URL=http://provisioner:8002
