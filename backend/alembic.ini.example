# Alembic 配置文件 — Heyu Agent
#
# 注意: sqlalchemy.url 不在此配置，由 migrations/env.py 从
# app.core.config.settings（即 .env 的 DATABASE_URL）读取并覆盖，
# 保持数据库连接串的单一来源。

[alembic]
script_location = migrations
prepend_sys_path = .

# 日志配置（migrations/env.py 通过 fileConfig 读取）
[loggers]
keys = root,sqlalchemy,alembic

[handlers]
keys = console

[formatters]
keys = generic

[logger_root]
level = WARN
handlers = console
qualname =

[logger_sqlalchemy]
level = WARN
handlers =
qualname = sqlalchemy.engine

[logger_alembic]
level = INFO
handlers =
qualname = alembic

[handler_console]
class = StreamHandler
args = (sys.stderr,)
level = NOTSET
formatter = generic

[formatter_generic]
format = %(levelname)-5.5s [%(name)s] %(message)s
datefmt = %H:%M:%S
