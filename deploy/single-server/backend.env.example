# ============================================================================
# Heyu Agent 单机部署 — backend 运行时密钥
# ============================================================================
# 复制为 backend.env 并填写。非密钥项（DATABASE_URL / SKILLHUB_* / ENVIRONMENT /
# STORAGE_BACKEND / RATE_LIMIT_BACKEND / CORS_ORIGINS）已在 docker-compose.yml
# 的 environment 段注入，请勿在此重复。

# ── 密钥（必填）──────────────────────────────────────────────
# JWT 签名密钥，随机长字符串即可（保持多实例/Java 端一致）。
SECRET_KEY=change-me-random-secret
ALGORITHM=HS512
LOGIN_USER_KEY=login_user_key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── LLM / 模型 API Key ──────────────────────────────────────
# config.yaml 的 models 用 $VOLCENGINE_API_KEY（tokenhub.tencentmaas.com）。
VOLCENGINE_API_KEY=
# 企查查 MCP（qcc-company / qcc-risk）
QCC_API_KEY=
# 通用 web_search 工具
WEB_SEARCH_API_KEY=
JINA_API_KEY=

# ── Checkpointer 清理（仅 postgres checkpointer 生效）────────
CHECKPOINT_CLEANUP_ENABLED=true
CHECKPOINT_CLEANUP_TTL_DAYS=30
CHECKPOINT_CLEANUP_INTERVAL_SECONDS=3600

# ── 会话创建限流（compose 已设 RATE_LIMIT_BACKEND=memory）──
CONVERSATION_CREATE_MIN_INTERVAL_SECONDS=3

# ── 文件存储（compose 已设 STORAGE_BACKEND=local）────────────
DOWNLOAD_URL_EXPIRES=3600
