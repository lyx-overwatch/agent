# ============================================================================
# Heyu Agent 单机部署 — Compose 级环境变量
# ============================================================================
# 复制为 .env 并填写。这些值只用于 docker compose 编排，不进入镜像。

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=agent

# ── 沙箱工作区（宿主机真实绝对路径）────────────────────────
# backend 容器内挂载到 /agent-test；同时作为沙箱容器 bind-mount 的源目录。
# 需确保该目录已存在，且 backend 容器（root）可写。
AGENT_TEST_HOST_DIR=/opt/heyu-agent/data/agent-test

# ── 前端对外端口 ────────────────────────────────────────────
FRONTEND_PORT=80
